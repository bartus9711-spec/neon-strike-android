; Engine configuration for native TeamCS 3D Android proof-of-concept.
config_version=5

[application]
config/name="TeamCS 3D"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/description="TeamCS 3D - native Android renderer, touch and Bluetooth controllers"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0
window/frame_pacing/android/enable_frame_pacing=false

[physics]
3d/default_gravity=24.0
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Android emulator bug Godot 4.7: Vulkan Swappy frame pacing VkResult error 5
; Disable until upstream 4.8 fix; keeps actual Vulkan 3D and real scene.


limits/opengl/max_lights_per_object=2
limits/opengl/max_renderable_lights=12
limits/opengl/max_decals=0
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.06, 0.10, 0.16, 1)
anti_aliasing/quality/msaa_3d=2

[editor_plugins]
enabled=PackedStringArray("res://addons/teamcs_network/plugin.cfg")
